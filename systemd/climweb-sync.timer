[Unit]
Description=Run climweb-sync hourly
Documentation=https://github.com/wmo-raf/climweb-product-sync

[Timer]
# Hourly by default. For products generated once a day, OnCalendar=*-*-* 06:30:00
# is kinder to a constrained link.
OnCalendar=hourly

# Spread the load if several services sync to the same ClimWeb host.
RandomizedDelaySec=5m

# Catch up after the server has been off or offline.
Persistent=true

[Install]
WantedBy=timers.target
